FROM registry.cn-guangzhou.aliyuncs.com/kestudy/golang:1.26.1-alpine AS builder
ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off
WORKDIR /build
ADD go.mod go.sum ./
ADD relaykit/go.mod ./relaykit/go.mod
RUN go mod download
COPY . .
RUN go build -ldflags "-s -w" -o upstream-benchmark-worker ./cmd/upstream-benchmark-worker

FROM registry.cn-guangzhou.aliyuncs.com/kestudy/bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates
COPY --from=builder /build/upstream-benchmark-worker /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 8081
WORKDIR /data
ENTRYPOINT ["/upstream-benchmark-worker"]
