# 全局API速率限制开关
GLOBAL_API_RATE_LIMIT_ENABLE=false
# 全局API速率限制(单IP)
GLOBAL_API_RATE_LIMIT=500
# 全局API速率限制窗口(秒)
GLOBAL_WEB_RATE_LIMIT_DURATION=500
# 全局Web速率限制开关
GLOBAL_WEB_RATE_LIMIT_ENABLE=false
# 全局Web速率限制(单IP)
GLOBAL_WEB_RATE_LIMIT=200
# 关键操作速率限制开关
GLOBAL_WEB_RATE_LIMIT_ENABLE=false
# 关键操作速率限制次数
CRITICAL_RATE_LIMIT=100

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
RELAY_TIMEOUT=300